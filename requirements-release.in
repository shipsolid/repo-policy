# Locked dependency for the release pipeline's version-bump/tag/changelog tool (see
# release.yml's three `pip install` steps, all in jobs that hold RELEASE_BOT_TOKEN or run
# immediately before it's used).
#
# Unlike requirements-action.in, this isn't a mirror of pyproject.toml's [project.dependencies] --
# python-semantic-release is a build-time tool for this repo's own release job, not something
# repo-policy itself depends on -- so there is no pyproject.toml cross-check here, only the
# regenerate-and-diff half of the pattern. See scripts/verify-release-lock.sh.
python-semantic-release==9.21.2
